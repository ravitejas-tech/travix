{
    "name": "travix",
    "version": "0.0.1",
    "private": true,
    "packageManager": "yarn@4.9.2",
    "workspaces": [
        "apps/*",
        "packages/*",
        "libs/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "test:e2e": "turbo run test:e2e",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "cli": "turbo run build --filter=cli^... && yarn workspace cli start:ts"
    },
    "devDependencies": {
        "@travix/eslint-config": "workspace:*",
        "@travix/typescript-config": "workspace:*",
        "mysql2": "^3.14.1",
        "prettier": "^3.2.5",
        "ts-node": "^10.9.2",
        "turbo": "^2.5.0",
        "typeorm": "^0.3.23",
        "typeorm-extension": "^3.7.1",
        "typescript": "^5.8.3"
    }
}
